# Token for the Custom Orb Provider created in Amp workspace settings (aop_live_...).
AMP_ORB_PROVIDER_TOKEN=

# Optional: OrbStack distro for new orbs. Must be glibc-based (not Alpine).
ORBSTACK_DISTRO=ubuntu:26.04

# Optional: extra `orbctl create` flags. Defaults to "--isolated --isolate-network".
# Set to an empty string to give orbs access to your Mac's files and network.
# ORBSTACK_CREATE_ARGS="--isolated --isolate-network --cpus 4 --memory 8G"

# Optional: path to orbctl if it isn't on PATH.
ORBCTL_BIN=
